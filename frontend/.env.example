# Stellar Crop Supply Chain - Soroban connection
# Copy to `.env.local` and fill in to connect the frontend to a live contract.
#
# When these are unset the API routes fall back to empty results so the app
# still boots locally without a network.

# Soroban RPC endpoint (e.g. Futurenet or a local container)
STELLAR_RPC_URL=

# Network passphrase, e.g. "Test SDF Future Network ; September 2015"
STELLAR_NETWORK_PASSPHRASE=

# Deployed crop supply contract address (C...)
STELLAR_CONTRACT_ID=

# Secret seed (S...) of the account that performs mutating calls
# (create contract, place order). Its public key is the farmer/buyer used by
# the API routes. NEVER commit a real secret.
STELLAR_SIGNER_SECRET=
